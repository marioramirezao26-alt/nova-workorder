* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #e5edf5;
  background: #081423;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  margin: 0;
  min-height: 100vh;
  background: linear-gradient(135deg, #081423 0%, #0f223d 100%);
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

#root {
  min-height: 100vh;
}

.app-shell {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px;
}

.auth-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  width: min(1000px, 100%);
  background: rgba(15, 26, 39, 0.8);
  border: 1px solid rgba(118, 168, 214, 0.2);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
}

.brand-box {
  background: linear-gradient(135deg, #123b63 0%, #0a213c 100%);
  padding: 48px 36px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.badge {
  display: inline-block;
  width: fit-content;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  padding: 8px 12px;
  font-size: 0.85rem;
  letter-spacing: 0.18em;
  margin-bottom: 12px;
}

.brand-box h1 {
  margin: 0;
  font-size: clamp(2.5rem, 4vw, 4rem);
  line-height: 1;
}

.brand-box p {
  color: #dbeaf9;
  font-size: 1rem;
  margin-top: 16px;
}

.auth-form,
.work-order-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 32px;
}

.auth-form {
  background: rgba(9, 18, 31, 0.8);
}

.switcher {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12px;
  padding: 6px;
  gap: 6px;
}

.switcher button {
  border: none;
  background: transparent;
  color: #dfeaf7;
  border-radius: 10px;
  padding: 10px 12px;
  font-weight: 600;
}

.switcher .active {
  background: #1a5aa6;
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #d5e7ff;
  font-size: 0.95rem;
}

input,
textarea,
select {
  width: 100%;
  border: 1px solid rgba(142, 176, 214, 0.25);
  border-radius: 12px;
  padding: 12px 14px;
  background: rgba(7, 14, 24, 0.9);
  color: #edf6ff;
}

textarea {
  resize: vertical;
}

.primary-btn,
.secondary-btn {
  border: none;
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(135deg, #2a7eea, #52a1ff);
  color: white;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.08);
  color: #edf6ff;
}

.dashboard {
  width: min(1200px, 100%);
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 28px;
  background: rgba(12, 24, 39, 0.8);
  border: 1px solid rgba(118, 168, 214, 0.2);
  border-radius: 18px;
}

.label {
  margin: 0;
  color: #9ec5f4;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.topbar h2 {
  margin: 6px 0 0 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.stat-card {
  background: rgba(12, 24, 39, 0.8);
  border: 1px solid rgba(118, 168, 214, 0.2);
  border-radius: 18px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stat-card span {
  color: #9ec5f4;
}

.stat-card strong {
  font-size: 2rem;
}

.content-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 24px;
}

.work-order-form,
.order-list {
  background: rgba(12, 24, 39, 0.8);
  border: 1px solid rgba(118, 168, 214, 0.2);
  border-radius: 18px;
}

.two-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.order-list {
  padding: 24px;
}

.order-list h3,
.work-order-form h3 {
  margin: 0 0 14px;
}

.order-card {
  background: rgba(19, 34, 52, 0.9);
  border: 1px solid rgba(118, 168, 214, 0.15);
  border-radius: 14px;
  padding: 16px;
  margin-top: 14px;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.order-head h4 {
  margin: 0;
}

.tag {
  display: inline-flex;
  border-radius: 999px;
  padding: 5px 10px;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
}

.tag.pendiente {
  background: rgba(255, 191, 0, 0.2);
  color: #ffdb75;
}

.tag.en_proceso {
  background: rgba(32, 143, 255, 0.2);
  color: #89c4ff;
}

.tag.completada {
  background: rgba(14, 197, 115, 0.2);
  color: #8be0b1;
}

.tag.cancelada {
  background: rgba(255, 85, 85, 0.2);
  color: #ff9e9e;
}

@media (max-width: 900px) {
  .auth-panel,
  .content-grid,
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .app-shell {
    padding: 20px;
  }
}
