PORT=5000
MONGODB_URI=mongodb://localhost:27017/nova-workorder
# Genera uno propio y largo, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
NODE_ENV=development
# Orígenes permitidos para el frontend, separados por comas (en producción, el dominio de la app).
# Vacío: en desarrollo se permite todo; en producción, solo el mismo origen.
CORS_ORIGINS=
# Detrás de un proxy (Caddy/Nginx): pon 1 para que el límite de intentos use la IP real.
TRUST_PROXY=
# API de plataforma (/api/platform): la usa GABY para crear empresas, ajustar planes y suspender por pagos.
# Vacía = apagada. Mínimo 32 caracteres; genérala igual que JWT_SECRET y ponla también en el .env de GABY.
PLATFORM_API_KEY=
# Contraseña de los usuarios de la empresa de demostración que crea `npm run seed` (mínimo 8 caracteres)
SEED_PASSWORD=
# Nombre de la empresa a la que `npm run migrate` asigna los datos de la versión 1.0
MIGRATE_COMPANY_NAME=
