PORT=5000
MONGODB_URI=mongodb://localhost:27017/nova-workorder
# Genera uno propio y largo, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
NODE_ENV=development
# Orígenes permitidos para el frontend, separados por comas (en producción, el dominio de la app).
# Vacío: en desarrollo se permite todo; en producción, solo el mismo origen.
CORS_ORIGINS=
# Detrás de un proxy (Caddy/Nginx): pon 1 para que el límite de intentos use la IP real.
TRUST_PROXY=
# API de plataforma (/api/platform): la usa GABY para crear empresas, ajustar planes y suspender por pagos.
# Vacía = apagada. Mínimo 32 caracteres; genérala igual que JWT_SECRET y ponla también en el .env de GABY.
PLATFORM_API_KEY=
# Contraseña de los usuarios de la empresa de demostración que crea `npm run seed` (mínimo 8 caracteres)
SEED_PASSWORD=
# Nombre de la empresa a la que `npm run migrate` asigna los datos de la versión 1.0
MIGRATE_COMPANY_NAME=
# Chat «GABY · Ventas» de la página de ventas: una IA que responde precios y dudas. Vacía = el chat no aparece.
# En el servidor se copia del .env de GABY (deploy/PUBLICAR.md, punto 7), nunca por chat.
OPENROUTER_API_KEY=
# Opcionales: modelo (por defecto anthropic/claude-haiku-5.5), tope de mensajes por día entre todos los visitantes
# (por defecto 300) y CHAT_ENABLED=false para apagarlo sin borrar la clave.
CHAT_MODEL=
CHAT_DAILY_LIMIT=
CHAT_ENABLED=
# El chat de la página atendido por GABY (la conversación queda en su CRM y Mario contesta desde su panel). Con la llave,
# /api/public/chat reenvía a GABY y, si GABY no responde, sigue con la IA de OPENROUTER_API_KEY. Vacía = solo esa IA.
# La llave es la misma GABY_WEBCHAT_KEY del .env de GABY; se copia en el servidor, nunca por chat.
GABY_WEBCHAT_KEY=
# Opcionales: la dirección de la API de GABY (por defecto http://127.0.0.1:8000/api/webchat) y la sal del hash de la IP
# que se le manda a GABY (sha256(ip + sal); sin ella se deriva de JWT_SECRET). GABY nunca recibe la IP.
GABY_WEBCHAT_URL=
WEBCHAT_IP_SALT=

# Conexiones a MongoDB por instancia (tráfico alto o varias instancias)
MONGO_POOL_SIZE=20

# Integraciones (docs/API.md). Opcionales: llave de la que salen los secretos de los webhooks (sin ella, JWT_SECRET)
# y peticiones por minuto de cada llave de API (120).
WEBHOOK_SECRET_KEY=
API_KEY_PER_MINUTE=

# Cobro con Wompi (cuenta de cada empresa, se conecta en «Integraciones»). Opcionales: la dirección pública de la app a
# la que Wompi devuelve al cliente después de pagar (sin ella, la del navegador que hizo la petición) y la llave de la
# que sale el cifrado de los secretos de cada empresa (sin ella, JWT_SECRET; cambiarla obliga a conectar Wompi de nuevo).
APP_URL=
COMPANY_SECRETS_KEY=
