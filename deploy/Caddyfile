# Caddy publica NOVA con HTTPS automático (Let's Encrypt):
#   NOVA_DOMINIO (app.novaworkorder.com)  -> la app NOVA WORKORDER (Node en 127.0.0.1:5000)
#   NOVA_SITIO (novaworkorder.com y www)  -> la página de ventas estática (/var/www/novaworkorder) y su formulario
# GABY sigue privada en Tailscale (puerto 8443) y Caddy no la toca.
# Caddy escucha SOLO en la IP pública (NOVA_BIND): Tailscale ya usa el 443 de la IP privada 100.x (`tailscale serve`
# del laboratorio), y escuchar en todas las IPs choca con él ("address already in use").
{
	default_bind {$NOVA_BIND}
}

(seguridad) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$NOVA_DOMINIO} {
	import seguridad
	reverse_proxy 127.0.0.1:5000
}

www.{$NOVA_SITIO} {
	import seguridad
	redir https://{$NOVA_SITIO}{uri} permanent
}

{$NOVA_SITIO} {
	import seguridad
	# P-034 A1: quién de los motores de IA (y Google y Bing) lee la página. Solo esos robots, con fecha, ruta y código;
	# sin IP, sin cookies, sin lo que va después del «?» y sin los demás encabezados (Ley 1581). Lo lee el pulso de Ada
	# (nova-cerebro, scripts/aeo_pulso.py) como usuario claude: el archivo es legible para todos y rota solo.
	@no_es_robot_ia not header_regexp User-Agent (?i)(OAI-SearchBot|ChatGPT-User|PerplexityBot|Perplexity-User|Claude-SearchBot|Claude-User|Googlebot|bingbot)
	log_skip @no_es_robot_ia
	log_append user_agent {http.request.header.User-Agent}
	log {
		output file /var/log/caddy/robots-ia.log {
			mode 0644
			roll_size 10MiB
			roll_keep 6
		}
		format filter {
			request>headers delete
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>tls delete
			request>uri regexp \?.* ""
			resp_headers delete
			user_id delete
		}
	}
	# solo el formulario «Pide tu demo» llega a la app desde este dominio
	handle /api/public/* {
		reverse_proxy 127.0.0.1:5000
	}
	handle {
		root * /var/www/novaworkorder
		try_files {path} {path}.html {path}/index.html
		file_server
		header /img/* Cache-Control "public, max-age=604800"
		header /video/* Cache-Control "public, max-age=604800"
	}
	handle_errors {
		@noexiste expression {err.status_code} == 404
		redir @noexiste https://{$NOVA_SITIO}/ 302
	}
}

# Otros productos de NOVA en este servidor (por ejemplo NOVA PEDIDOS) agregan aquí su sitio, cada uno en su archivo.
# Pueden usar el snippet `seguridad`. Si la carpeta está vacía o no existe, Caddy sigue igual.
import /etc/caddy/sitios/*.caddy
